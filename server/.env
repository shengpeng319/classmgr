# 本地开发默认值：SQLite。云端部署时通过环境变量注入 MySQL 连接串覆盖。
DATABASE_URL="file:./dev.db"

# ---- AI 助手 ----
# 供应商：zhipu（默认）| deepseek
AI_PROVIDER=zhipu
# API Key（智谱在 https://open.bigmodel.cn 控制台获取；留空时 /ai/chat 返回友好提示）
AI_API_KEY=9898957077ce46469435c369b4b1527b.UX9Z2OTCHfFMRzI9
# 文本模型（缺省 glm-4-flash；deepseek 缺省 deepseek-chat）
AI_MODEL=glm-4-flash
# 视觉模型供应商（缺省同 AI_PROVIDER；DeepSeek 无视觉模型，图片请求需切到 zhipu）
AI_VISION_PROVIDER=
# 视觉模型（缺省 glm-4v-flash）
AI_VISION_MODEL=glm-4v-flash

