generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Family {
  id         String   @id @default(uuid())
  name       String   // 家庭名称，默认"XX家"
  inviteCode String   @default("") @unique // 6位邀请码，家庭成员展示给新家长加入
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  users      User[]
  children   Child[]
}

model Child {
  id           String    @id @default(uuid())
  familyId     String
  name         String
  gender       String    @default("male")
  age          Int?
  avatar       String?
  points       Int       @default(0)   // 积分从 User 迁来
  isActive     Boolean   @default(true) // 二期"启用/停用"预留
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  family       Family    @relation(fields: [familyId], references: [id])
  tasks        Task[]
  schedules    Schedule[]
  pointRecords PointRecord[]
  studentCards StudentCard[]
  records      Record[]
  courseStudents CourseStudent[]
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  role      String   @default("parent") // "admin"(兼家长的管理员) or "parent"；旧值 "user" 迁移时统一转 "parent"
  name      String?
  avatar    String?
  gender    String   @default("male")
  age       Int      @default(0)
  phone     String?
  points    Int      @default(0)  // 积分（用于抽卡）
  familyId  String?  // admin/parent 必有；预留 null
  openid       String?  // 微信小程序 openid（订阅消息用）
  notifyEnabled Boolean @default(false)  // 上课提醒开关
  remindMinutes Int     @default(30)    // 课前提前多少分钟提醒
  msgQuota      Int     @default(0)     // 订阅消息剩余额度（点一次允许+1，发一条-1）
  lastNotifyDate String? // 最近一次发过当日汇总提醒的日期(yyyy-mm-dd)，一天只发一条
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  family    Family?  @relation(fields: [familyId], references: [id])
  rememberedUsers RememberedUser[]
  tasks     Task[]
  schedules Schedule[]
  courseStudents CourseStudent[]
  records   Record[]
  ownedCards StudentCard[]
  pointRecords PointRecord[]
}

model RememberedUser {
  id           String   @id @default(uuid())
  userId       String
  deviceId     String
  rememberToken String
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id])
  
  @@unique([userId, deviceId])
}

model Course {
  id          String   @id @default(uuid())
  name        String
  description String?
  color       String?  @default("#87CEEB")
  dayOfWeek   Int      // 0-6, 0=Sunday
  startTime   String   // "09:00"
  endTime     String   // "10:00"
  location    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  students    CourseStudent[]
}

model CourseStudent {
  id        String   @id @default(uuid())
  userId    String
  courseId  String
  childId   String?  // 迁移后非空，挂 Child.id（保留 userId 一版）
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  child     Child?   @relation(fields: [childId], references: [id])
  course    Course   @relation(fields: [courseId], references: [id])

  @@unique([userId, courseId])
}

model Record {
  id          String   @id @default(uuid())
  userId      String
  courseId    String
  childId     String?  // 迁移后非空（保留 userId 一版）
  date        DateTime
  status      String   // "attended", "absent", "late"
  note        String?
  pointsEarned Int     @default(0)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  child       Child?   @relation(fields: [childId], references: [id])
}

model Card {
  id          String   @id @default(uuid())
  name        String
  description String?
  rarity      String   // "common", "rare", "epic", "legendary"
  image       String?
  pointsCost  Int      @default(10)
  stock       Int      @default(-1)  // -1 = unlimited
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  owners      StudentCard[]
}

model StudentCard {
  id        String   @id @default(uuid())
  userId    String
  cardId    String
  childId   String?  // 迁移后非空（保留 userId 一版）
  drawnAt   DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
  child     Child?   @relation(fields: [childId], references: [id])
  card      Card     @relation(fields: [cardId], references: [id])
}

model Task {
  id          String    @id @default(uuid())
  title       String
  type        String    // "school" | "tutoring" | "homework" | "sports" | "art" | "other"
  points      Int       @default(5)  // 任务积分
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  userId      String    // 关联用户（保留一版，代码不再读写）
  childId     String?   // 迁移后非空，挂 Child.id
  startDate   DateTime  // 有效开始日期
  endDate     DateTime  // 有效结束日期
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  child       Child?    @relation(fields: [childId], references: [id])
}

model Schedule {
  id          String    @id @default(uuid())
  name        String    // 课程名称
  dayOfWeek   String    // "1,3" 逗号分隔的星期几，0=周日
  startTime   String    // "09:00"
  endTime     String    // "10:00"
  location    String?   // 上课地点
  type        String    // "school" | "tutoring" | "homework" | "sports" | "art" | "other"
  color       String?   @default("#87CEEB")  // 颜色标记
  isDailyTask Boolean   @default(false)  // 是否为当日任务
  points      Int       @default(1)  // 任务积分
  userId      String    // 关联用户（保留一版，代码不再读写）
  childId     String?   // 迁移后非空，挂 Child.id
  startDate   DateTime? // 有效期起始（为空表示从过去任何时间开始）
  endDate     DateTime? // 有效期结束（为空表示永久有效）
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User      @relation(fields: [userId], references: [id])
  child       Child?    @relation(fields: [childId], references: [id])
}

model PointRecord {
  id          String   @id @default(uuid())
  userId      String
  childId     String?  // 迁移后非空（保留 userId 一版）
  taskId      String?  // 关联任务ID
  taskTitle   String   // 任务标题（冗余存储，方便显示）
  points      Int      // 积分变化（正数表示获得，负数表示扣除）
  reason      String   // 原因： "完成任务" | "取消完成"
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
  child       Child?   @relation(fields: [childId], references: [id])
}

model PresetPointItem {
  id        String   @id @default(uuid())
  label     String   // 显示名称，如 "完成作业"
  points    Int      // 积分数量
  type      String   @default("add")  // "add" or "subtract"
  icon      String?  // 图标名称
  color     String?  // 颜色
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
